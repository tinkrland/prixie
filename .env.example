# browserbase (the join engine: every platform is joined through a headless browser)
BROWSERBASE_API_KEY=your_browserbase_api_key
BROWSERBASE_PROJECT_ID=your_project_id

# assembly.ai (transcription + speaker labels for browserbase session recordings)
ASSEMBLYAI_API_KEY=your_assemblyai_key

# supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# public url of your backend. the in-page chat monitor posts real time events here
BASE_URL=https://your-backend-url.com

# port
PORT=3000

# scheduler
ENABLE_SCHEDULER=true

# bot display name (defaults to prixie)
BOT_NAME=prixie

# google calendar (optional, for calendar sync)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# speechmatics (optional, for hinglish / non-english STT)
SPEECHMATICS_API_KEY=your_speechmatics_key

# speechify (optional, for future voice feature / TTS)
SPEECHIFY_API_KEY=your_speechify_key

# vapi (optional, for future voice interaction)
VAPI_API_KEY=your_vapi_key

# her inbox (agentmail-style provider: forward a meeting invite to her
# address and she joins). unset = the door stays closed.
AGENTMAIL_WEBHOOK_SECRET=your_shared_webhook_secret

# zoom web sdk (the participant path: chat, raise hand, post-join popups).
# a "meeting sdk" app in the zoom marketplace.
ZOOM_SDK_KEY=your_zoom_sdk_key
ZOOM_SDK_SECRET=your_zoom_sdk_secret

# microsoft calendar via graph (pull sources: the scheduler re-reads them
# each cycle; unset = skipped, not faked)
OUTLOOK_ACCESS_TOKEN=your_graph_access_token

# apple calendar via caldav (icloud: use an app-specific password)
APPLE_CALDAV_URL=https://caldav.icloud.com
APPLE_CALDAV_USERNAME=your_icloud_email
APPLE_CALDAV_PASSWORD=your_app_specific_password
